rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 1. BRAND SETTINGS & PROFILE (Read-Only)
    // ==========================================
    match /brand_settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /brand_profile/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================
    // 2. SOLUTIONS & CATALOG (Read-Only)
    // ==========================================
    match /solutions/{solutionId} {
      allow read: if true;
      allow write: if false;
    }

    match /solutions_catalog/{solutionId} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================
    // 3. MARKETING DIRECTORY & FAQS (Read-Only)
    // ==========================================
    match /marketing_directory/{networkId} {
      allow read: if true;
      allow write: if false;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if false;
    }

    // ==========================================
    // 4. USERS COLLECTION (Strictly Denied)
    // ==========================================
    match /users/{userId} {
      allow read, write: if false;
    }

    // ==========================================
    // 5. WEBINAR LEADS (Strict Validation, No Deletion)
    // ==========================================
    function isValidLeadCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name', 'phone', 'email', 'objective', 'industry',
          'referralCode', 'createdAt', 'registeredAt', 'source', 'status',
          'notes', 'tags'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 25
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 50));
    }

    match /webinar_leads/{leadId} {
      // Allow read for live admin CRM
      allow read: if true;
      // Allow create only if schema matches strict rules
      allow create: if isValidLeadCreate();
      // Allow admin status / notes update, but prevent changing student identity
      allow update: if request.resource.data.name == resource.data.name
        && request.resource.data.phone == resource.data.phone;
      // Prohibit unauthenticated deletion of leads (Zero Data Loss)
      allow delete: if false;
    }

    // ==========================================
    // 6. COACHING PORTALS (Schema Validation, No Deletion)
    // ==========================================
    function isValidPortalCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'instituteName', 'directorName', 'contactPhone', 'city',
          'domainRequested', 'category', 'status', 'createdAt', 'source',
          'features', 'notes', 'customSubdomain'
        ])
        && data.instituteName is string && data.instituteName.size() > 0 && data.instituteName.size() <= 150
        && data.contactPhone is string && data.contactPhone.size() >= 7 && data.contactPhone.size() <= 25
        && (data.status == 'pending' || data.status == 'active');
    }

    match /coaching_portals/{portalId} {
      allow read: if true;
      allow create: if isValidPortalCreate();
      // Allow updates to status (e.g. approve portal) but prevent changing original institute
      allow update: if request.resource.data.instituteName == resource.data.instituteName;
      // Prohibit arbitrary deletion of portals
      allow delete: if false;
    }
  }
}
