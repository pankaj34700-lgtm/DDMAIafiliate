rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Brand info & Site Configuration (Public Read, Admin Write)
    match /brand_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Solutions & Packages Catalog (Public Read)
    match /solutions/{solutionId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Marketing Directory (Public Read)
    match /marketing_directory/{networkId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. Webinar Leads (Public Create, Admin Read)
    match /webinar_leads/{leadId} {
      allow read, write: if true;
    }

    // 5. Coaching Portals (Public Read & Create, Admin Approve)
    match /coaching_portals/{portalId} {
      allow read, write: if true;
    }

    // 6. FAQs (Public Read)
    match /faqs/{faqId} {
      allow read, write: if true;
    }

    // 7. Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Default match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
